{
  "name": "cookie-guard",
  "description": "Local-first cookie cleanup and conservative consent rejection.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "check": "npm run compile && npm run build && npm run build:firefox",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
